{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "编译当前文件 (C语言 gcc)",
            "command": "D:/VScode/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/CProgram/out_exe/${fileBasenameNoExtension}.exe"
