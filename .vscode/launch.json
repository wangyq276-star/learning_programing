{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 C 程序 (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/CProgram/out_exe/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/VScode/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "编译当前文件 (C语言 gcc)"
        },
